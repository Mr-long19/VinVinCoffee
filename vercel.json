{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/admin",
      "dest": "/api/admin.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/api.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
