{
  "routes": [
    {
      "src": "/api.php",
      "dest": "/api.php"
    },
    {
      "src": "/admin.php",
      "dest": "/admin.php"
    },
    {
      "src": "/admin",
      "dest": "/admin.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
