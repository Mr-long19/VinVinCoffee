{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php"
    }
  },
  "rewrites": [
    {
      "source": "/admin.php",
      "destination": "/api/admin.php"
    },
    {
      "source": "/admin",
      "destination": "/api/admin.php"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.php"
    }
  ]
}
