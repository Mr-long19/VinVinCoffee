{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.3"
    }
  },
  "build": {
    "env": {
      "NODE_VERSION": "20.x"
    }
  },
  "routes": [
    {
      "src": "/admin.php",
      "dest": "/api/admin.php"
    },
    {
      "src": "/admin",
      "dest": "/api/admin.php"
    }
  ]
}
