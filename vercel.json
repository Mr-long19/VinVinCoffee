{
  "functions": {
    "api.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "admin.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api.php"
    },
    {
      "src": "/admin",
      "dest": "/admin.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
