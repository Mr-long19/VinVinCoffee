{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/admin(.*)",
      "dest": "/admin.php$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
