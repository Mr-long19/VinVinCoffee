{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api.php"
    }
  ]
}
